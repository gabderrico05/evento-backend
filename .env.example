# Configuração do Banco de Dados
# IMPORTANTE: Copie este arquivo para .env e preencha com suas credenciais reais

# Flask
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development

# Encryption Key for AES-256 (CRÍTICO: Gere uma chave única e segura!)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA versione a chave real!
ENCRYPTION_KEY=your-encryption-key-here-64-hex-chars-minimum-32-bytes-entropy

# Database Configuration
# Para SQLite (desenvolvimento):
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=src/database/app.db

# Para PostgreSQL (produção - RECOMENDADO):
# DATABASE_TYPE=postgresql
# DB_USER=evento_app_user
# DB_PASSWORD=your-secure-password-here
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=evento_db

# Para MySQL (produção):
# DATABASE_TYPE=mysql
# DB_USER=evento_app_user
# DB_PASSWORD=your-secure-password-here
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=evento_db

# Session Configuration
SESSION_TYPE=filesystem
SESSION_PERMANENT=False
SESSION_USE_SIGNER=True
SESSION_FILE_DIR=.flask_session
