# ====================================
# CONFIGURAÇÃO DO AMBIENTE
# ====================================
# IMPORTANTE: Copie este arquivo para .env e preencha com suas credenciais reais

# Flask Environment (development, production, testing)
FLASK_ENV=development

# Secret Key - CRÍTICO: Gere uma chave única e segura em produção!
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Encryption Key for AES-256 (CRÍTICO: Gere uma chave única e segura!)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA versione a chave real!
ENCRYPTION_KEY=your-encryption-key-here-64-hex-chars-minimum-32-bytes-entropy

# ====================================
# DATABASE CONFIGURATION
# ====================================

# -------------------------------------
# DEVELOPMENT (SQLite)
# -------------------------------------
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=src/database/app.db

# -------------------------------------
# PRODUCTION (PostgreSQL - RECOMENDADO)
# -------------------------------------
# Descomente as linhas abaixo e comente as linhas de SQLite acima:
# DATABASE_TYPE=postgresql
# DB_USER=evento_app_user
# DB_PASSWORD=your-secure-password-here
# DB_HOST=your-database-host.com
# DB_PORT=5432
# DB_NAME=evento_db
# DB_SSL_MODE=require

# -------------------------------------
# PRODUCTION (MySQL - Alternativa)
# -------------------------------------
# DATABASE_TYPE=mysql
# DB_USER=evento_app_user
# DB_PASSWORD=your-secure-password-here
# DB_HOST=your-database-host.com
# DB_PORT=3306
# DB_NAME=evento_db
# DB_SSL_CA=/path/to/ca-cert.pem

# ====================================
# SESSION CONFIGURATION
# ====================================
SESSION_TYPE=filesystem
SESSION_FILE_DIR=.flask_session
SESSION_COOKIE_SECURE=False  # True em produção (HTTPS)
